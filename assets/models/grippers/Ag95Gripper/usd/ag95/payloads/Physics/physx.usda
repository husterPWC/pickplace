        }

        over "right_inner_knuckle_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.01
            float physxJoint:maxJointVelocity = 120.32114
        }

        over "right_outer_knuckle_joint" (
