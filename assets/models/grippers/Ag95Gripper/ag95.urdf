<?xml version="1.0" encoding="utf-8"?>
<!--
  DH Robotics AG95 URDF converted from Ag95Gripper.xml.

  The source model is a closed four-bar mechanism. URDF cannot represent a
  closed kinematic loop, so this model uses the standard tree approximation:
  left_outer_knuckle_joint is the actuated joint and the other five revolute
  joints mimic it. This preserves the intended visual/contact motion, but an
  importer must support <mimic> for coupled motion.

  Inertial properties below were compiled directly from the uploaded MuJoCo
  collision geometry (density 2700 kg/m^3). Millimetre STL files use a 0.001
  scale; finger_pad_0/1 are already stored in metres and therefore use scale 1.
-->
<robot name="dh_ag95">
  <material name="ag95_grey"><color rgba="0.517647 0.537647 0.547647 1"/></material>
  <material name="ag95_black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="ag95_base_link">
    <inertial>
      <origin xyz="-0.00104524 -0.00052509 0.05525585"
              rpy="0.0170311957 0.000684745941 1.60490213"/>
      <mass value="1.29594696343"/>
      <inertia ixx="0.00227885" ixy="0" ixz="0" iyy="0.00191909" iyz="0" izz="0.00076022"/>
    </inertial>
    <visual>
      <geometry><mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_grey"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/gripper_body.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="meshes/gripper_body.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <link name="grasp_frame"/>
  <joint name="grasp_frame_joint" type="fixed">
    <parent link="ag95_base_link"/>
    <child link="grasp_frame"/>
    <origin xyz="0 0 0.2" rpy="3.141592653589793 0 0"/>
  </joint>

  <link name="left_inner_knuckle">
    <inertial>
      <origin xyz="-0.00106612 0.02540029 0.02749709" rpy="0 -0.00616649 0"/>
      <mass value="0.064076261344"/>
      <inertia ixx="3.01208330e-05" ixy="0" ixz="0" iyy="1.73937986e-05" iyz="0" izz="1.35009279e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0.016 0.0254 -0.10586" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/inner_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <collision>
      <origin xyz="-0.016 0.0254 -0.10586" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/inner_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="left_inner_knuckle_joint" type="revolute">
    <parent link="ag95_base_link"/>
    <child link="left_inner_knuckle"/>
    <origin xyz="0.016 -0.0254 0.10586" rpy="0 0.790790855288 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.943" effort="100" velocity="2.1"/>
    <dynamics damping="0.1" friction="0.01"/>
    <mimic joint="left_outer_knuckle_joint" multiplier="1" offset="0"/>
  </joint>

  <link name="left_outer_knuckle">
    <inertial>
      <origin xyz="0.0277170764 0.00874956123 -4.43809736e-07"
              rpy="3.14159265359 -1.57079632679 0"/>
      <mass value="0.0321546411431"/>
      <inertia ixx="8.78276045e-06" ixy="0" ixz="0" iyy="8.63433717e-06" iyz="0" izz="5.68311040e-07"/>
    </inertial>
    <visual>
      <origin xyz="-0.036673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/outer_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <collision>
      <origin xyz="-0.036673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/outer_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="left_outer_knuckle_joint" type="revolute">
    <parent link="ag95_base_link"/>
    <child link="left_outer_knuckle"/>
    <origin xyz="0.036673 -0.00875 0.098336" rpy="0 -0.780005587443 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.943" effort="100" velocity="2.1"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <link name="left_finger">
    <inertial>
      <origin xyz="-0.01722275 0.00875005 0.01663155"
              rpy="-0.459092041 -2.55690498e-06 1.57079759"/>
      <mass value="0.0389228930961"/>
      <inertia ixx="9.84890159e-06" ixy="0" ixz="0" iyy="9.80164602e-06" iyz="0" izz="2.14878660e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <visual>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_0.stl"/></geometry>
      <material name="ag95_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_1.stl"/></geometry>
      <material name="ag95_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_0.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_1.stl"/></geometry>
    </collision>
  </link>
  <joint name="left_finger_joint" type="revolute">
    <parent link="left_outer_knuckle"/>
    <child link="left_finger"/>
    <origin xyz="0.055 0 0" rpy="0 0.780005587443 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.943" effort="100" velocity="2.1"/>
    <dynamics damping="0.1" friction="0.01"/>
    <mimic joint="left_outer_knuckle_joint" multiplier="1" offset="0"/>
  </joint>

  <link name="right_inner_knuckle">
    <inertial>
      <origin xyz="-0.00106612 0.02540029 0.02749709" rpy="0 -0.00616649 0"/>
      <mass value="0.064076261344"/>
      <inertia ixx="3.01208330e-05" ixy="0" ixz="0" iyy="1.73937986e-05" iyz="0" izz="1.35009279e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0.016 0.0254 -0.10586" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/inner_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <collision>
      <origin xyz="-0.016 0.0254 -0.10586" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/inner_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="right_inner_knuckle_joint" type="revolute">
    <parent link="ag95_base_link"/>
    <child link="right_inner_knuckle"/>
    <origin xyz="-0.016 0.0254 0.10586" rpy="0 0.790790855288 -3.14159265359"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.943" effort="100" velocity="2.1"/>
    <dynamics damping="0.1" friction="0.01"/>
    <mimic joint="left_outer_knuckle_joint" multiplier="1" offset="0"/>
  </joint>

  <link name="right_outer_knuckle">
    <inertial>
      <origin xyz="0.0277170764 0.00874956123 -4.43809736e-07"
              rpy="3.14159265359 -1.57079632679 0"/>
      <mass value="0.0321546411431"/>
      <inertia ixx="8.78276045e-06" ixy="0" ixz="0" iyy="8.63433717e-06" iyz="0" izz="5.68311040e-07"/>
    </inertial>
    <visual>
      <origin xyz="-0.036673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/outer_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <collision>
      <origin xyz="-0.036673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/outer_knuckle.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="right_outer_knuckle_joint" type="revolute">
    <parent link="ag95_base_link"/>
    <child link="right_outer_knuckle"/>
    <origin xyz="-0.036673 0.00875 0.098336" rpy="0 -0.780005587443 3.14159265359"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.943" effort="100" velocity="2.1"/>
    <dynamics damping="0.1" friction="0.01"/>
    <mimic joint="left_outer_knuckle_joint" multiplier="1" offset="0"/>
  </joint>

  <link name="right_finger">
    <inertial>
      <origin xyz="-0.01722275 0.00875005 0.01663155"
              rpy="-0.459092041 -2.55690498e-06 1.57079759"/>
      <mass value="0.0389228930961"/>
      <inertia ixx="9.84890159e-06" ixy="0" ixz="0" iyy="9.80164602e-06" iyz="0" izz="2.14878660e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ag95_black"/>
    </visual>
    <visual>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_0.stl"/></geometry>
      <material name="ag95_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_1.stl"/></geometry>
      <material name="ag95_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_0.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.091673 0.00875 -0.098336" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_pad_1.stl"/></geometry>
    </collision>
  </link>
  <joint name="right_finger_joint" type="revolute">
    <parent link="right_outer_knuckle"/>
    <child link="right_finger"/>
    <origin xyz="0.055 0 0" rpy="0 0.780005587443 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.943" effort="100" velocity="2.1"/>
    <dynamics damping="0.1" friction="0.01"/>
    <mimic joint="left_outer_knuckle_joint" multiplier="1" offset="0"/>
  </joint>
</robot>
